+def _manual_iso(raw) -> str | None:
+    """A hand-typed date as YYYY-MM-DD, or None. Upstream reads only zero-padded ISO (or M/D/YYYY); strptime here
+    accepts '2025-3-25', so the date always goes through parse_portal_date and is re-printed, never forwarded."""
+    text = str(raw or "").strip()
+    if not text:
+        return None
+    mdY = parse_portal_date(text)
+    return datetime.strptime(mdY, "%m/%d/%Y").strftime("%Y-%m-%d") if mdY else None
+
