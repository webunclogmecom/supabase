+def cache_failed_result(run_id: str, payload: dict, reason: str = "POST failed", replace: bool = False):
     """
     Store a POST payload locally so a later run can retry it. The next run
     flushes whatever is still cached before fetching new work.
@@ -420,14 +419,20 @@ def cache_failed_result(run_id: str, payload: dict,
     159 ms BEFORE its own SUCCESS line. Nothing had failed. A log that
     reports a failure on a clean run costs the next reader the same minutes
     it cost this one, so the caller now says why the payload was cached.
+
+    replace=True is for ONE caller, the manual final payload after a failed POST: it overwrites
+    the seed in place (id, created_at and retry_count kept). Everything else stays first-write-wins.
     """
     conn = get_connection()
     c = conn.cursor()
     try:
-        c.execute('''
-            INSERT OR IGNORE INTO pending_api_results (run_id, payload)
-            VALUES (?, ?)
-        ''', (run_id, json.dumps(payload)))
+        if replace:
+            c.execute('''INSERT INTO pending_api_results (run_id, payload) VALUES (?, ?)
+                         ON CONFLICT(run_id) DO UPDATE SET payload = excluded.payload''',
+                      (run_id, json.dumps(payload)))
+        else:
+            c.execute('''INSERT OR IGNORE INTO pending_api_results (run_id, payload) VALUES (?, ?)''',
+                      (run_id, json.dumps(payload)))
         conn.commit()
         log.info(f"Cached result payload locally [run_id={run_id}]: {reason}")
     finally:
