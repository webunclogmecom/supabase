{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["scripts/sync/**", "scripts/lib/**", "services/timed-jobs/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node scripts/sync/run_logged.js railway_samsara_gps scripts/sync/cron_samsara_locations_history.js",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
