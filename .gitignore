**/_*.js
**/_*.cjs
**/_*.mjs
**/_*.sql
**/_*.py
**/_*.sh

# Generated analysis outputs — regenerable from the scripts that emit them
**/*_results.json
**/*_raw.json
reports/
docs/reports/*.pdf

# Local agent config + scratch dirs
.claude/
.temp/

# scratch JSON/JSONL (one-off probe outputs)
**/_*.json
**/_*.jsonl
